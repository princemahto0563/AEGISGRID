# ==============================================================================
# AegisGrid Resilience Intelligence Agent Configuration (.env)
# Fetch-A-Thon 3.0 ASI:One Agent Challenge
# ==============================================================================

# --- 1. Agent Identity ---
# Agent name registered with protocols
AGENT_NAME=aegisgrid_resilience_agent

# Secret seed phrase used to deterministically derive the agent's keypair and address.
# WARNING: Replace with your own unique private seed phrase. Never share or commit it.
AGENT_SEED="aegisgrid fetchathon 3 resilience intelligence simulation seed"

# Network environment: "mainnet" (Fetch.ai Mainnet) or "testnet" (Fetch.ai Testnet)
AGENT_NETWORK=mainnet

# --- 2. Connection Modes (Choose Mode A or Mode B) ---

# [MODE A] LOCAL DEVELOPMENT (Default)
# Set AGENT_MAILBOX=false to run locally on your machine.
# Starts local server on AGENT_PORT and serves ACP endpoints and the Agent Inspector.
# No public IP, domain, or blockchain gas funds required.
AGENT_MAILBOX=false
AGENT_PORT=8000

# [MODE B] AGENTVERSE MAILBOX (Recommended for ASI:One Discovery without public IP)
# Set AGENT_MAILBOX=true to connect outbound to Agentverse's hosted mailbox.
# The local agent polls Agentverse for incoming messages from ASI:One.
# 1. Set AGENT_MAILBOX=true
# 2. Run: .venv/bin/python agent.py
# 3. Click the Agent Inspector link in terminal to register the mailbox with 1 click.
# AGENT_MAILBOX=true

# --- 3. Optional: External Integration Endpoint ---
# ONLY set this if deploying the agent on a public cloud server (e.g. Render, Railway, AWS, Fly.io)
# with a publicly accessible HTTPS URL and valid SSL certificate.
# NOTE: Do NOT set to 127.0.0.1 or localhost (Agentverse cloud cannot reach local loopback).
# AGENT_ENDPOINT=https://your-public-domain.com/submit

# --- 4. Optional: Advanced Agentverse Settings ---
# AGENTVERSE_URL=https://agentverse.ai
# AGENTVERSE_API_KEY=
